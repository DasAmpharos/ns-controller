{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", ":semanticCommitsDisabled"],
  "timezone": "America/New_York",
  "schedule": ["before 6am on saturday"],
  "lockFileMaintenance": {"enabled": true, "schedule": ["before 6am on saturday"]},
  "packageRules": [
    {
      "description": "One PR a week for routine Python updates (both uv projects: the old server and nsctl)",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Python minor and patch updates"
    }
  ],
  "customManagers": [
    {
      "description": "Pico SDK version the firmware builds against (installed under ~/.pico-sdk/sdk/<version>)",
      "customType": "regex",
      "managerFilePatterns": ["/^firmware/CMakeLists\\.txt$/"],
      "matchStrings": ["set\\(PICO_SDK_VERSION (?<currentValue>\\d+\\.\\d+\\.\\d+)\\)"],
      "depNameTemplate": "raspberrypi/pico-sdk",
      "datasourceTemplate": "github-releases"
    }
  ]
}
